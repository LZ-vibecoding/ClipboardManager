<Window x:Class="ClipboardManager.Wpf.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ClipboardManager.Core.Models;assembly=ClipboardManager.Core"
        xmlns:conv="clr-namespace:ClipboardManager.Wpf.Converters"
        Title="剪贴板历史"
        Width="420" Height="600"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#F5F5F5">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CornerRadius="10"
                      ResizeBorderThickness="5"
                      CaptionHeight="36"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:ClipboardTypeToIconConverter x:Key="TypeToIcon"/>
        <conv:BoolToPinIconConverter x:Key="BoolToPinIcon"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyVis"/>
        <conv:PathToImageConverter x:Key="PathToImage"/>
    </Window.Resources>

    <!-- 主容器 → WindowChrome 自带圆角和阴影 -->
    <Border Margin="0" CornerRadius="10" Background="#F5F5F5"
            BorderBrush="#E0E0E0" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 顶部标题栏（拖动区域：WindowChrome CaptionHeight=36）── -->
            <Grid Grid.Row="0" Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="剪贴板历史"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#1A1A1A" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- 最小化按钮 → 吸附侧边栏 -->
                    <Button x:Name="MinimizeBtn" Content="─" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#666666" FontSize="14" Cursor="Hand"
                            Click="OnMinimizeClick" ToolTip="吸附侧边栏"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Width="28" Height="28">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E5E5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 关闭按钮 -->
                    <Button Content="✕" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#666666" FontSize="14" Cursor="Hand"
                            Click="OnCloseClick" ToolTip="关闭"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Width="28" Height="28">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E5E5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── 搜索框 ── -->
            <Border Grid.Row="1" Margin="14,10" CornerRadius="6"
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" Margin="10,0,6,0"
                               VerticalAlignment="Center" FontSize="13"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="2,7" BorderThickness="0"
                             Background="Transparent"
                             Foreground="#1A1A1A"
                             VerticalAlignment="Center"/>
                    <Button x:Name="ClearSearchBtn" Grid.Column="2"
                            Content="✕" Width="22" Height="22"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#999999" FontSize="11"
                            Visibility="Collapsed"
                            Cursor="Hand" Click="OnClearSearch"/>
                </Grid>
            </Border>

            <!-- ── 条目列表 ── -->
            <Grid Grid.Row="2">
                <!-- 空状态提示 -->
                <TextBlock Text="暂无剪贴板历史记录。&#x0a;复制文本或图片后会自动记录。"
                           Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}"
                           FontSize="13" Foreground="#999999"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="30,60,30,0" LineHeight="22"/>

                <!-- 条目列表 -->
                <ScrollViewer Margin="0,0,0,0" Padding="0,0,0,10"
                              Style="{StaticResource ModernScrollViewStyle}"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <!-- 分组标题 -->
                                    <TextBlock Text="{Binding Header}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#666666"
                                               Margin="14,10,14,4"/>

                                    <!-- 组内条目 -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:ClipboardItem">
                                                <Border Style="{StaticResource ItemCardStyle}"
                                                                        MouseDown="OnItemMouseDown">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 类型图标 -->
                                                        <Border Grid.Column="0"
                                                                Width="32" Height="32"
                                                                CornerRadius="4"
                                                                Background="#E8F4FD"
                                                                Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Type, Converter={StaticResource TypeToIcon}}"
                                                                       FontSize="14"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- 内容预览 -->
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center">
                                                            <!-- 文本预览 -->
                                                            <TextBlock Text="{Binding TextContent}"
                                                                       FontSize="13"
                                                                       Foreground="#1A1A1A"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxHeight="40" LineHeight="20"
                                                                       Visibility="{Binding TextContent, Converter={StaticResource StringNotEmptyVis}}"/>

                                                            <!-- 图片预览 -->
                                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToImage}}"
                                                                   MaxWidth="80" MaxHeight="60"
                                                                   Stretch="Uniform"
                                                                   Visibility="{Binding ImagePath, Converter={StaticResource StringNotEmptyVis}}"/>

                                                            <!-- 时间 -->
                                                            <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:HH:mm}}"
                                                                       FontSize="11"
                                                                       Foreground="#999999"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 操作按钮 -->
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="4,0,0,0">
                                                            <!-- 固定按钮 -->
                                                            <Button Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="固定 / 取消固定"
                                                                    Style="{StaticResource IconButtonStyle}">
                                                                <TextBlock Text="{Binding IsPinned, Converter={StaticResource BoolToPinIcon}}"
                                                                           FontSize="14"/>
                                                            </Button>

                                                            <!-- 粘贴按钮 -->
                                                            <Button Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="粘贴"
                                                                    Style="{StaticResource IconButtonStyle}"
                                                                    Margin="2,0,0,0">
                                                                <TextBlock Text="📋" FontSize="14"/>
                                                            </Button>

                                                            <!-- 删除按钮 -->
                                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="删除"
                                                                    Style="{StaticResource IconButtonStyle}"
                                                                    Margin="2,0,0,0">
                                                                <TextBlock Text="🗑" FontSize="13"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 右下角调整大小手柄（纯视觉提示） -->
                <TextBlock Text="🯨" FontSize="11" Foreground="#BBBBBB"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,4,2" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
