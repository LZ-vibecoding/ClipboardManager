<Window x:Class="ClipboardManager.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板管理器 - 设置"
        Width="420" Height="480"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border Margin="8" CornerRadius="10" Background="#F5F5F5"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Opacity="0.15" BlurRadius="16"
                              ShadowDepth="3" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── 标题栏 ── -->
            <Grid Grid.Row="0" Margin="14,14,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙ 设置"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#1A1A1A" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#666666" FontSize="14" Cursor="Hand"
                        Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4" Width="28" Height="28">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E5E5E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ── 设置项列表 ── -->
            <ScrollViewer Grid.Row="1" Margin="14,10,14,0"
                          Style="{StaticResource ModernScrollViewStyle}">
                <StackPanel Margin="0,0,0,10">

                    <!-- 分组：存储 -->
                    <TextBlock Text="存储" FontSize="12" FontWeight="SemiBold"
                               Foreground="#666666" Margin="0,8,0,4"/>
                    <Border Style="{StaticResource ItemCardStyle}" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="最大条目数"
                                       FontSize="13" Foreground="#1A1A1A"/>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" x:Name="MaxItemSlider"
                                        Minimum="20" Maximum="1000" TickFrequency="10"
                                        Value="{Binding MaxItemCount}"
                                        IsSnapToTickEnabled="True"
                                        Foreground="#0078D4"/>
                                <TextBox Grid.Column="1" Text="{Binding MaxItemCount}"
                                         FontSize="12" TextAlignment="Center"
                                         Margin="6,0,0,0" VerticalAlignment="Center"
                                         BorderBrush="#E0E0E0" BorderThickness="1"
                                         Background="White"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 分组：监控 -->
                    <TextBlock Text="剪贴板监控" FontSize="12" FontWeight="SemiBold"
                               Foreground="#666666" Margin="0,12,0,4"/>
                    <Border Style="{StaticResource ItemCardStyle}" Padding="12,10">
                        <StackPanel>
                            <CheckBox Content="监控文本复制" IsChecked="{Binding MonitorText}"
                                      FontSize="13" Foreground="#1A1A1A"
                                      Margin="0,2,0,2"/>
                            <CheckBox Content="监控图片复制" IsChecked="{Binding MonitorImages}"
                                      FontSize="13" Foreground="#1A1A1A"
                                      Margin="0,4,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- 分组：系统 -->
                    <TextBlock Text="系统" FontSize="12" FontWeight="SemiBold"
                               Foreground="#666666" Margin="0,12,0,4"/>
                    <Border Style="{StaticResource ItemCardStyle}" Padding="12,10">
                        <CheckBox Content="开机自启" IsChecked="{Binding AutoStartWithWindows}"
                                  FontSize="13" Foreground="#1A1A1A"
                                  Margin="0,2,0,2"/>
                    </Border>

                    <!-- 分组：图片处理 -->
                    <TextBlock Text="图片处理" FontSize="12" FontWeight="SemiBold"
                               Foreground="#666666" Margin="0,12,0,4"/>
                    <Border Style="{StaticResource ItemCardStyle}" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="缩略图尺寸"
                                       FontSize="13" Foreground="#1A1A1A"/>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="40" Maximum="256"
                                        TickFrequency="8"
                                        Value="{Binding ThumbnailSize}"
                                        IsSnapToTickEnabled="True"
                                        Foreground="#0078D4"/>
                                <TextBox Grid.Column="1" Text="{Binding ThumbnailSize}"
                                         FontSize="12" TextAlignment="Center"
                                         Margin="6,0,0,0" VerticalAlignment="Center"
                                         BorderBrush="#E0E0E0" BorderThickness="1"
                                         Background="White"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="图片存储质量"
                                       FontSize="13" Foreground="#1A1A1A"
                                       Margin="0,10,0,0"/>
                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="10" Maximum="100"
                                        TickFrequency="5"
                                        Value="{Binding ImageQuality}"
                                        IsSnapToTickEnabled="True"
                                        Foreground="#0078D4"/>
                                <TextBox Grid.Column="1" Text="{Binding ImageQuality}"
                                         FontSize="12" TextAlignment="Center"
                                         Margin="6,0,0,0" VerticalAlignment="Center"
                                         BorderBrush="#E0E0E0" BorderThickness="1"
                                         Background="White"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── 版本信息 ── -->
                    <TextBlock Text="v1.0 · 数据存储在本地 · 不上传任何信息"
                               FontSize="11" Foreground="#999999"
                               TextAlignment="Center" Margin="0,14,0,4"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ── 底部按钮 ── -->
            <Grid Grid.Row="2" Margin="14,6,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="取消"
                        Width="80" Height="32"
                        Background="#F0F0F0" BorderBrush="#D0D0D0"
                        BorderThickness="1" Foreground="#333333"
                        FontSize="13" Cursor="Hand" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"/>

                <Button Grid.Column="2" Content="保存"
                        Width="80" Height="32"
                        Background="#0078D4" BorderThickness="0"
                        Foreground="White" FontSize="13" Cursor="Hand"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
