<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主色调（使用 SolidColorBrush 确保兼容 BorderBrush/Background 等 Brush 属性） -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#0078D4"/>
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#E8F4FD"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#666666"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="HoverColor" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DangerColor" Color="#E81123"/>

    <!-- 条目卡片样式 -->
    <Style x:Key="ItemCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="8,3"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Opacity="0.05" BlurRadius="4" ShadowDepth="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮 -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4" Width="28" Height="28">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 搜索框样式 -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动视图样式（滚动条靠右，不遮挡内容） -->
    <Style x:Key="ModernScrollViewStyle" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter Margin="0,0,10,0"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   Width="6"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,3,16"
                                   Minimum="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分隔符 -->
    <Style x:Key="ModernSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderColor}"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Height" Value="1"/>
    </Style>
</ResourceDictionary>
